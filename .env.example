# ==== FinderBot — конфиг (скопируйте в .env и заполните) ====

# --- Telegram (обязательно) ---
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram-числовой ID (узнать: @userinfobot). Админу доступен дефолтный Soulseek-аккаунт
ADMIN_USER_ID=

# --- Soulseek (опционально) ---
# Креды для ВАС самих (админа); обычные пользователи вводят свои через /login
#SOULSEEK_USER=
#SOULSEEK_PASS=

# --- Разрешённые домены для видео (JSON-список или через запятую) ---
ALLOWED_HOSTS=["youtube.com","youtu.be","tiktok.com","instagram.com"]

# --- yt-dlp ---
# Прокси для YouTube на VPS (часто YouTube банит датацентровые IP):
#YTDLP_PROXY=socks5://user:pass@host:1080
# Cookies-файл (Netscape-form) для Instagram/TikTok/возрастных YouTube-видео:
#YTDLP_COOKIES=cookies.txt

# --- Лимиты ---
MAX_FILE_MB=48
MAX_VIDEO_MINUTES=120
WORKERS=3
QUEUE_PER_USER=3
REQUESTS_PER_MINUTE=4

# --- Таймауты ---
SEARCH_TIMEOUT_SEC=120
SONG_DOWNLOAD_TIMEOUT_SEC=900
VIDEO_DOWNLOAD_TIMEOUT_SEC=1800

# --- Пути (по умолчанию относительные от папки запуска) ---
#TOOLS_DIR=tools/bin
#DATA_DIR=data
#DOWNLOAD_DIR=downloads

# --- Поиск песни (конвейер в стиле StreamToOffline) ---
# Форматы, которые sockseek ищет (список через запятую):
SLSK_FORMATS=mp3,flac,m4a,wav,ogg
# Фильтр версий: auto (не ремиксы/эдиты/live/cover) | all | original | edits | remixes
SLSK_VERSION_POLICY=auto
# Допуск по длительности к эталону «(3:45)» из запроса пользователя (секунды)
SLSK_LENGTH_TOLERANCE_SEC=5
# Минимальный битрейт для lossy (None — не фильтровать; lossless не режется)
#SLSK_MIN_BITRATE=

# --- Шифрование сохранённых Soulseek-паролей ---
# Пусто → случайный ключ в data/secret.key (не удаляйте его, иначе все перелогинятся).
# Можно задать свою фразу-пароль (выводится в детерминированный Fernet-ключ):
#ENCRYPT_KEY=

# --- Прочее ---
LOG_LEVEL=INFO
KEEP_FILES=false
